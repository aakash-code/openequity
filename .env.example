# OpenEquity Environment Variables

# =================================
# APPLICATION
# =================================
APP_NAME=OpenEquity Research Platform
ENVIRONMENT=development

# =================================
# FRONTEND
# =================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# =================================
# BACKEND
# =================================
HOST=0.0.0.0
PORT=8000
DEBUG=True

# =================================
# DATABASE
# =================================
DATABASE_URL=postgresql://openequity:openequity_dev_password@postgres:5432/openequity
DATABASE_POOL_SIZE=20

# =================================
# REDIS
# =================================
REDIS_URL=redis://redis:6379/0

# =================================
# SECURITY
# =================================
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =================================
# DATA PROVIDERS
# =================================
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
SEC_EDGAR_USER_AGENT=OpenEquity contact@openequity.org

# =================================
# OAUTH (for future implementation)
# =================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =================================
# FEATURE FLAGS
# =================================
ENABLE_AI_FEATURES=False
ENABLE_WEBSOCKETS=True
ENABLE_RATE_LIMITING=True

# =================================
# MONITORING (for future implementation)
# =================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
