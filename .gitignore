# OpenEquity .gitignore

# Environment variables
.env
.env.local
.env*.local
*.env

# Dependencies
node_modules/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
.next/
out/
build/
dist/
*.egg-info/

# Testing
coverage/
.coverage
.pytest_cache/
.tox/
htmlcov/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.db
*.sqlite
*.sqlite3

# Docker
.docker/

# OS
Thumbs.db
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# Secrets
secrets/
credentials/
*.pem
*.key
!infrastructure/nginx/ssl/.gitkeep
